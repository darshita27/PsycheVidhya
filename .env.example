# Copy this file to .env and fill in real values. Never commit .env.

PORT=5000

# Comma-separated list of origins allowed to call the API (leave empty in dev to allow same-origin only)
CLIENT_ORIGIN=http://localhost:5000

# MongoDB connection string (e.g. from MongoDB Atlas)
MONGODB_URI=mongodb://localhost:27017/psychevidhya

# Long random string used to sign admin login sessions — generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Chat assistant — set ONE of these free-tier keys (Groq is used first if both are set).
# Groq (recommended: fast, generous free tier) — https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Google Gemini (also free) — https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Optional legacy fallback — only used if neither key above is set. Paid.
OPENAI_API_KEY=

# Outgoing email (booking confirmations + admin notifications). Any SMTP provider works
# (Gmail app password, SendGrid, Postmark, etc). Leave blank in dev — emails will just be logged.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="Manova Mental Wellness <no-reply@psychevidhya.com>"

# Where booking/contact notifications are sent
ADMIN_EMAIL=vanupriyasingh28@gmail.com
